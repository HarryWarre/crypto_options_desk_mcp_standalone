# ─────────────────────────────────────────────────────────────────────────────
# trading-mcp configuration — ALL OPTIONAL.
#
# Read/analytics tools (GEX, vanna, skew, flow, vol surface, indicators, klines,
# funding, OI, options chain, IV-RV, strategy analysis) use Bybit PUBLIC market
# data and need NO credentials.
#
# Only the two user-position tools require an API key:
#   get_user_options_positions, get_user_all_positions
# A read-only Bybit API key is sufficient (and recommended).
# ─────────────────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional historical options archive for POST /api/v1/backtests:
# OPTIONS_BACKTEST_ARCHIVE=./data/bybit-options.jsonl

# Logging (MCP speaks JSON-RPC over stdio, so logs go to a file, never stdout):
# MCP_LOG_FILE=/tmp/mcp-trading.log
# DEBUG_MCP=1

# ─────────────────────────────────────────────────────────────────────────────
# Jev Browser Agent & Automation Configuration
# ─────────────────────────────────────────────────────────────────────────────
# TypeSafe API key (or OPENROUTER_API_KEY) powers the Jev browser decision model:
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=

# Typing model provider override (google, openai, anthropic, openrouter):
# JEV_BROWSER_TYPE_PROVIDER=google
# JEV_BROWSER_TYPE_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# Headed mode (1 = display browser UI, unset = headless):
# JEV_BROWSER_HEADED=1
